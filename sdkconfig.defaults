CONFIG_IDF_TARGET="esp32c3"

# ESP32-C3 SuperMini: 4 MB flash, two OTA slots (partitions.csv)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Log and protocol share the native USB port; the firmware keeps them from
# interleaving inside a packet (see main/smart_esp.c)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_MAX_SOCKETS=10

# BLE (NimBLE) for commissioning while the pairing window is open:
# peripheral only, one host, no BLE-level pairing (Noise runs on top)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# smart-core limits: 1 USB host + 3 network hosts (TCP or BLE)
CONFIG_SMART_MAX_SESSIONS=4
CONFIG_SMART_MAX_PROPS=16
